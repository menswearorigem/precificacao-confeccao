# Copie este arquivo para .env e preencha os valores para rodar localmente.

# String de conexão do Postgres (local ou Render).
DATABASE_URL=postgres://usuario:senha@localhost:5432/precificacao_confeccao

# Coloque "false" só se estiver usando um Postgres local sem SSL.
DATABASE_SSL=true

# Porta do servidor Express.
PORT=3000

# "production" em produção. NÃO É DETALHE: é essa variável que liga o cookie
# de sessão seguro, o HSTS e o redirecionamento para HTTPS.
NODE_ENV=development

# ---------------------------------------------------------------------------
# SEGREDOS — sem eles o servidor NÃO SOBE em produção (ver src/lib/config.js).
# ---------------------------------------------------------------------------
# Trava usada para criar a PRIMEIRA conta de administrador. Mínimo 12
# caracteres. Gere uma senha longa e guarde no gerenciador de senhas.
APP_PASSWORD=

# Segredo que assina o cookie de sessão. Mínimo 32 caracteres.
# Gere assim:  openssl rand -hex 32
# Quem tiver este valor consegue fabricar um cookie de administrador e entrar
# como qualquer pessoa. Trate como a chave do cofre.
SESSION_SECRET=

# Validade da sessão de login, em horas (168 = 7 dias).
SESSION_HOURS=168

# Endereço público do sistema. Usado para montar o link de redefinição de
# senha no e-mail. Ex.: https://hbnhub.onrender.com
APP_URL=

# ---------------------------------------------------------------------------
# E-MAIL — sem isso a recuperação de senha e o lembrete de usuário NÃO chegam.
# Confira em Acessos › Histórico › "Enviar e-mail de teste".
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
# "false" para a porta 587 (STARTTLS), "true" para a 465.
SMTP_SECURE=false
SMTP_USER=
# No Gmail precisa ser uma senha de app, não a senha normal da conta.
SMTP_PASS=
SMTP_FROM=

# Copie este arquivo para .env e preencha os valores para rodar localmente.

# String de conexão do Postgres (local ou Render).
DATABASE_URL=postgres://usuario:senha@localhost:5432/precificacao_confeccao

# Coloque "false" só se estiver usando um Postgres local sem SSL.
DATABASE_SSL=true

# Porta do servidor Express.
PORT=3000

# Senha compartilhada de login da equipe. TROQUE antes de publicar.
APP_PASSWORD=troque-esta-senha

# Segredo usado para assinar o cookie de sessão. TROQUE antes de publicar.
SESSION_SECRET=troque-este-segredo

# Validade da sessão de login, em horas.
SESSION_HOURS=168
